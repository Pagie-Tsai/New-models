                    if (h === '狀態') {
                        let badgeClass = 'bg-slate-100 text-slate-700 border-slate-200';
                        if (val.includes('量產')) badgeClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                        else if (val.includes('開發')) badgeClass = 'bg-sky-50 text-sky-700 border-sky-200';
                        else if (val.includes('暫停') || val.includes('取消') || val.includes('停止')) badgeClass = 'bg-rose-50 text-rose-700 border-rose-200';
                        val = '<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold border ' + badgeClass + ' inline-block">' + val + '</span>';
                    }

                    // 針對「實體」與「CAN」以不同顏色區分標示
                    if (val === '實體') {
                        val = '<span class="badge-physical">實體</span>';
                    } else if (val === 'CAN') {
                        val = '<span class="badge-can">CAN</span>';
                    }

                    bodyHtml += '<td class="px-3.5 py-2 whitespace-nowrap text-slate-700 border-b border-sky-50 ' + stickyClass + '">' + val + '</td>';
                });
                bodyHtml += '</tr>';
            });
            tbody.innerHTML = bodyHtml;
        }

        function filterData() {
            currentFilteredData = rawData.filter(row => {
                let matchAll = true;
                activeSearchCols.forEach(h => {
                    const el = document.getElementById('search_' + h);
                    if (el) {
                        const query = el.value.trim().toLowerCase();
                        if (query !== '') {
                            const cellVal = (row[h] || '').toLowerCase();
                            if (el.tagName === 'SELECT') {
                                if (cellVal !== query) matchAll = false;
                            } else {
                                if (!cellVal.includes(query)) matchAll = false;
                            }
                        }
                    }
                });
                return matchAll;
            });
            renderTable(currentFilteredData);
        }

        function clearSearch() {
            activeSearchCols.forEach(h => {
                const el = document.getElementById('search_' + h);
                if (el) el.value = '';
            });
            filterData();
        }

        function exportCSV() {
            let csvContent = "\uFEFF" + headers.join(",") + "\n";
            currentFilteredData.forEach(row => {
                let rowData = headers.map(h => '"' + (row[h] || '').replace(/"/g, '""') + '"');
                csvContent += rowData.join(",") + "\n";
            });
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('href', url);
            a.setAttribute('download', '研發課開發進度清單.csv');
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        initTableHeader();
        renderAdvancedSearchPanel();
        filterData();
    </script>
</body>
</html>
